{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows-msvc",
      "displayName": "Windows x64, pinned MSVC and raylib",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "toolset": "version=14.44.35207",
      "binaryDir": "${sourceDir}/build-windows-msvc",
      "cacheVariables": {
        "THREADLIGHT_USE_PINNED_RAYLIB": "ON",
        "THREADLIGHT_RAYLIB_ROOT": "$env{THREADLIGHT_RAYLIB_ROOT}"
      }
    },
    {
      "name": "windows-msvc-portable",
      "displayName": "Windows x64, isolated portable-release build",
      "inherits": "windows-msvc",
      "binaryDir": "${sourceDir}/build-portable-windows-msvc"
    }
  ],
  "buildPresets": [
    { "name": "windows-msvc-release", "configurePreset": "windows-msvc", "configuration": "Release" },
    { "name": "windows-msvc-portable-release", "configurePreset": "windows-msvc-portable", "configuration": "Release" }
  ],
  "testPresets": [
    { "name": "windows-msvc-release", "configurePreset": "windows-msvc", "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "windows-msvc-portable-release", "configurePreset": "windows-msvc-portable", "configuration": "Release", "output": { "outputOnFailure": true } }
  ]
}
